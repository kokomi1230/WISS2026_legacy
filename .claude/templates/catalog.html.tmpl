<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{TITLE}}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700;800&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Sans+JP:wght@400;500;700&display=swap">
<style>
  :root {
    --bg: #0a0a0c;
    --bg-elev: #111114;
    --bg-row: #16161a;
    --bg-row-hover: #1c1c22;
    --fg: #ededed;
    --fg-soft: #b3b3b8;
    --muted: #6e6e76;
    --rule: #26262c;
    --rule-soft: #1c1c22;
    --accent: #5eead4;       /* teal */
    --accent-deep: #14b8a6;
    --accent-soft: rgba(94, 234, 212, 0.12);
    --self: #fbbf24;         /* amber */
    --official: #60a5fa;     /* blue */
    --restricted: #f472b6;   /* pink */
    --community: #a78bfa;    /* purple */
    --danger: #f87171;
    --sans: "IBM Plex Sans", "IBM Plex Sans JP", "Hiragino Sans", system-ui, sans-serif;
    --mono: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; height: 100%; }
  body {
    font-family: var(--sans);
    background: var(--bg);
    color: var(--fg);
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    font-feature-settings: "ss01", "cv11";
  }
  ::selection { background: var(--accent); color: var(--bg); }

  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* Top bar */
  .topbar {
    position: sticky; top: 0; z-index: 50;
    background: rgba(10, 10, 12, 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .topbar-inner {
    max-width: 1200px; margin: 0 auto;
    padding: 14px 24px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
  }
  .brand {
    font-family: var(--mono); font-weight: 700;
    font-size: 0.92rem; letter-spacing: -0.02em;
    color: var(--fg);
    display: flex; align-items: center; gap: 8px;
  }
  .brand .prompt { color: var(--accent); }
  .brand .path { color: var(--fg-soft); }

  .topbar-status {
    font-family: var(--mono); font-size: 0.78rem;
    color: var(--muted); justify-self: end;
    display: flex; gap: 18px; align-items: center;
  }
  .topbar-status .live { color: var(--accent); }
  .topbar-status .kbd {
    display: inline-block;
    border: 1px solid var(--rule);
    border-bottom-width: 2px;
    padding: 1px 6px; border-radius: 4px;
    background: var(--bg-elev);
    color: var(--fg-soft);
    font-size: 0.7rem;
  }

  /* Search inline in topbar */
  .search-wrap {
    position: relative;
    display: flex; align-items: center;
  }
  .search-wrap .sigil {
    position: absolute; left: 12px;
    font-family: var(--mono);
    color: var(--accent);
    font-size: 0.86rem;
    pointer-events: none;
  }
  #search {
    width: 100%;
    background: var(--bg-elev);
    border: 1px solid var(--rule);
    color: var(--fg);
    padding: 9px 12px 9px 28px;
    border-radius: 6px;
    font: inherit;
    font-family: var(--mono);
    font-size: 0.84rem;
  }
  #search:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .search-hint {
    position: absolute; right: 10px;
    font-family: var(--mono); font-size: 0.7rem;
    color: var(--muted);
    pointer-events: none;
  }

  /* Hero */
  .hero {
    max-width: 1200px; margin: 0 auto;
    padding: 48px 24px 24px;
  }
  .hero-top {
    font-family: var(--mono); font-size: 0.74rem;
    color: var(--muted); letter-spacing: -0.005em;
    display: flex; gap: 12px; flex-wrap: wrap;
    margin-bottom: 22px;
  }
  .hero-top .pill {
    border: 1px solid var(--rule); padding: 3px 10px;
    border-radius: 999px; color: var(--fg-soft);
  }
  .hero-top .pill.accent { color: var(--accent); border-color: var(--accent); }
  .hero h1 {
    font-family: var(--mono); font-weight: 700;
    font-size: clamp(2rem, 5vw, 3.4rem);
    line-height: 1.02; letter-spacing: -0.04em;
    margin: 0 0 14px; color: var(--fg);
  }
  .hero h1 .blink {
    color: var(--accent);
    animation: blink 1.1s steps(2) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }
  .hero p.deck {
    font-family: var(--sans);
    color: var(--fg-soft);
    max-width: 56ch;
    margin: 0 0 24px;
    font-size: 0.98rem;
    line-height: 1.6;
  }

  /* Stats bar */
  .stats {
    max-width: 1200px; margin: 0 auto;
    padding: 0 24px 24px;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: 8px;
    overflow: hidden;
  }
  .stat {
    background: var(--bg-elev);
    padding: 18px 16px 14px;
  }
  .stat .lbl {
    font-family: var(--mono); font-size: 0.68rem;
    color: var(--muted); letter-spacing: 0;
    text-transform: lowercase;
  }
  .stat .num {
    font-family: var(--mono); font-weight: 800;
    font-size: 1.9rem; line-height: 1;
    margin-top: 8px;
    letter-spacing: -0.03em;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }
  .stat .num.self { color: var(--self); }
  .stat .num.official { color: var(--official); }
  .stat .num.community { color: var(--community); }
  .stat .delta {
    font-family: var(--mono); font-size: 0.72rem;
    color: var(--muted); margin-top: 4px;
  }

  /* Filter bar */
  .filter-bar {
    max-width: 1200px; margin: 0 auto;
    padding: 14px 24px 12px;
    position: sticky;
    top: 56px; z-index: 40;
    background: rgba(10, 10, 12, 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .filter-bar h3 {
    font-family: var(--mono); font-size: 0.7rem;
    color: var(--muted); letter-spacing: 0.04em;
    text-transform: lowercase;
    margin: 0 0 10px;
    display: flex; align-items: center; gap: 8px;
  }
  .filter-bar h3 .prompt { color: var(--accent); }
  .filter-row { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .src-toggle { display: flex; gap: 0; border: 1px solid var(--rule); border-radius: 6px; overflow: hidden; }
  .src-btn {
    appearance: none; background: var(--bg-elev);
    color: var(--fg-soft); border: none;
    padding: 6px 12px; cursor: pointer;
    font: inherit; font-family: var(--mono); font-size: 0.76rem;
    border-right: 1px solid var(--rule);
  }
  .src-btn:last-child { border-right: none; }
  .src-btn:hover { background: var(--bg-row-hover); color: var(--fg); }
  .src-btn.active { background: var(--accent); color: var(--bg); font-weight: 600; }
  .src-btn.active[data-src="self"] { background: var(--self); }
  .src-btn.active[data-src="official"] { background: var(--official); color: var(--bg); }
  .src-btn.active[data-src="official-restricted"] { background: var(--restricted); color: var(--bg); }
  .src-btn.active[data-src="community"] { background: var(--community); color: var(--bg); }
  .cat-toggle {
    display: flex; flex-wrap: wrap; gap: 0;
    border: 1px solid var(--rule); border-radius: 6px;
    overflow: hidden;
  }
  .cat-btn {
    appearance: none; background: var(--bg-elev);
    color: var(--fg-soft); border: none;
    padding: 6px 11px; cursor: pointer;
    font: inherit; font-family: var(--mono); font-size: 0.76rem;
    border-right: 1px solid var(--rule);
  }
  .cat-btn:last-child { border-right: none; }
  .cat-btn:hover { background: var(--bg-row-hover); color: var(--fg); }
  .cat-btn.active { background: var(--fg); color: var(--bg); font-weight: 600; }
  .cat-btn .ct { color: var(--muted); margin-left: 6px; font-size: 0.7rem; }
  .cat-btn.active .ct { color: var(--bg); opacity: 0.7; }
  .clear-btn {
    margin-left: auto;
    appearance: none; background: transparent;
    border: 1px solid var(--rule);
    color: var(--fg-soft);
    padding: 6px 12px; border-radius: 6px;
    cursor: pointer; font: inherit;
    font-family: var(--mono); font-size: 0.76rem;
  }
  .clear-btn:hover { border-color: var(--danger); color: var(--danger); }

  /* Active filters */
  .active-filters {
    margin-top: 10px;
    display: flex; flex-wrap: wrap; gap: 6px;
    font-family: var(--mono); font-size: 0.74rem;
    min-height: 24px;
  }
  .active-filters:empty { display: none; }
  .active-filter {
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--accent-soft);
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: 2px 8px 2px 10px;
    border-radius: 999px;
  }
  .active-filter .x {
    cursor: pointer; opacity: 0.7;
    font-weight: 700;
  }
  .active-filter .x:hover { opacity: 1; }

  /* Main */
  main { max-width: 1200px; margin: 0 auto; padding: 24px 24px 96px; }

  /* Section heading */
  .section-head {
    margin: 56px 0 24px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
    display: flex; align-items: baseline; gap: 14px;
  }
  .section-head .marker {
    font-family: var(--mono); color: var(--accent);
    font-size: 0.84rem;
  }
  .section-head h2 {
    font-family: var(--mono); font-weight: 700;
    font-size: 1.4rem; letter-spacing: -0.02em;
    margin: 0; color: var(--fg);
  }
  .section-head p {
    margin: 0 0 0 auto;
    color: var(--muted); font-size: 0.84rem;
    font-family: var(--sans);
  }

  /* Category */
  .category { margin-bottom: 36px; scroll-margin-top: 140px; }
  .category.is-hidden { display: none; }
  .cat-head {
    display: flex; align-items: baseline; gap: 14px;
    padding: 10px 0;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 0;
  }
  .cat-idx {
    font-family: var(--mono); color: var(--accent);
    font-size: 0.84rem; font-weight: 700;
  }
  .cat-title {
    font-family: var(--mono); font-weight: 700;
    font-size: 1.05rem; letter-spacing: -0.01em;
    margin: 0;
    color: var(--fg);
  }
  .cat-count {
    font-family: var(--mono); color: var(--muted);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
  }
  .cat-kbd {
    margin-left: auto;
    font-family: var(--mono); font-size: 0.7rem;
    color: var(--muted);
    border: 1px solid var(--rule);
    border-bottom-width: 2px;
    padding: 1px 6px; border-radius: 4px;
    background: var(--bg-elev);
  }

  /* Skill rows */
  .row {
    display: grid;
    grid-template-columns: 120px 1fr 40px;
    gap: 16px;
    padding: 14px 14px 14px 14px;
    border-bottom: 1px solid var(--rule-soft);
    align-items: start;
    transition: background 0.08s;
  }
  .row:hover { background: var(--bg-row); }
  .row.is-hidden { display: none; }
  .r-meta {
    font-family: var(--mono); font-size: 0.72rem;
    padding-top: 2px;
  }
  .r-sigil {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 3px;
    font-weight: 600;
    font-size: 0.7rem;
    letter-spacing: 0;
  }
  .r-sigil[data-k="self"] { background: rgba(251,191,36,0.12); color: var(--self); border: 1px solid rgba(251,191,36,0.3); }
  .r-sigil[data-k="official"] { background: rgba(96,165,250,0.12); color: var(--official); border: 1px solid rgba(96,165,250,0.3); }
  .r-sigil[data-k="official-restricted"] { background: rgba(244,114,182,0.12); color: var(--restricted); border: 1px solid rgba(244,114,182,0.3); }
  .r-sigil[data-k="community"] { background: rgba(167,139,250,0.12); color: var(--community); border: 1px solid rgba(167,139,250,0.3); }

  .r-head {
    display: flex; align-items: baseline; gap: 12px;
    flex-wrap: wrap; margin-bottom: 6px;
  }
  .r-name {
    font-family: var(--mono); font-weight: 600;
    font-size: 0.98rem; letter-spacing: -0.015em;
    margin: 0; color: var(--fg);
  }
  .r-path {
    font-family: var(--mono); font-size: 0.74rem;
    color: var(--muted);
  }
  .r-desc {
    margin: 0 0 10px;
    font-size: 0.9rem; line-height: 1.55;
    color: var(--fg-soft);
  }
  .r-foot {
    display: flex; gap: 14px;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 6px;
  }
  .r-tags {
    display: flex; gap: 4px; flex-wrap: wrap;
    align-items: center;
  }
  .tag-chip {
    appearance: none;
    background: var(--bg-elev);
    color: var(--accent);
    border: 1px solid var(--rule);
    padding: 1px 7px;
    border-radius: 3px;
    font-family: var(--mono);
    font-size: 0.7rem;
    cursor: pointer;
    transition: border-color 0.1s;
  }
  .tag-chip::before { content: "#"; color: var(--muted); }
  .tag-chip:hover { border-color: var(--accent); }
  .tag-chip.active {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
    font-weight: 600;
  }
  .tag-chip.active::before { color: rgba(10, 10, 12, 0.6); }
  .tag-more {
    font-family: var(--mono); font-size: 0.7rem;
    color: var(--muted);
  }
  .r-profiles {
    display: flex; gap: 4px; flex-wrap: wrap;
    margin-left: auto;
  }
  .prof-pill {
    font-family: var(--mono); font-size: 0.68rem;
    color: var(--muted);
    border: 1px solid var(--rule-soft);
    padding: 1px 6px;
    border-radius: 3px;
  }
  .r-source {
    margin-top: 8px;
    font-family: var(--mono); font-size: 0.7rem;
    color: var(--muted);
    opacity: 0.7;
  }
  .r-actions {
    display: flex; justify-content: flex-end; align-items: flex-start;
  }
  .copy-btn {
    appearance: none;
    background: transparent;
    border: 1px solid var(--rule);
    color: var(--muted);
    font: inherit; font-family: var(--mono); font-size: 0.7rem;
    padding: 4px 8px;
    border-radius: 4px;
    cursor: pointer;
    opacity: 0.6;
    transition: all 0.1s;
  }
  .row:hover .copy-btn { opacity: 1; }
  .copy-btn:hover { border-color: var(--accent); color: var(--accent); }
  .copy-btn.copied { background: var(--accent); color: var(--bg); border-color: var(--accent); }

  /* B / C / D tables */
  .dev-table {
    width: 100%; border-collapse: collapse;
    margin-top: 10px;
    background: var(--bg-elev);
    border: 1px solid var(--rule);
    border-radius: 6px;
    overflow: hidden;
  }
  .dev-table th, .dev-table td {
    text-align: left; padding: 10px 14px;
    border-bottom: 1px solid var(--rule-soft);
    vertical-align: top;
    font-size: 0.88rem;
  }
  .dev-table tbody tr:last-child td { border-bottom: none; }
  .dev-table thead th {
    font-family: var(--mono); font-weight: 600;
    font-size: 0.7rem; letter-spacing: 0.04em;
    color: var(--muted); background: var(--bg);
    text-transform: lowercase;
    border-bottom: 1px solid var(--rule);
  }
  .dev-table tbody tr:hover { background: var(--bg-row); }
  .dev-table td.mono { font-family: var(--mono); font-size: 0.82rem; }
  .dev-table td.mono.small { font-size: 0.74rem; color: var(--fg-soft); }
  .dev-table td.name { color: var(--fg); font-weight: 600; }
  .plugin-group {
    margin-bottom: 12px;
    border: 1px solid var(--rule);
    border-radius: 6px;
    overflow: hidden;
  }
  .plugin-group summary {
    cursor: pointer; padding: 12px 16px;
    background: var(--bg-elev);
    list-style: none;
    display: flex; align-items: center; gap: 10px;
  }
  .plugin-group summary::-webkit-details-marker { display: none; }
  .plugin-group summary::after {
    content: ""; margin-left: auto;
    width: 8px; height: 8px;
    border-right: 1.5px solid var(--muted);
    border-bottom: 1.5px solid var(--muted);
    transform: rotate(45deg); transition: transform 0.15s;
  }
  .plugin-group[open] summary::after { transform: rotate(-135deg); }
  .plugin-grp-label {
    font-family: var(--mono); font-weight: 600;
    color: var(--fg); font-size: 0.86rem;
  }
  .plugin-grp-ct {
    font-family: var(--mono); color: var(--muted);
    font-size: 0.78rem;
  }
  .plugin-group .dev-table {
    margin: 0; border: none; border-radius: 0;
    border-top: 1px solid var(--rule);
  }

  /* No-match */
  .no-match {
    display: none;
    padding: 64px 24px; text-align: center;
    font-family: var(--mono); color: var(--muted);
    font-size: 0.9rem;
  }
  body.is-no-match .no-match { display: block; }
  .no-match code { color: var(--accent); }

  /* Help overlay */
  .help-overlay {
    position: fixed; inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
    display: none;
    align-items: center; justify-content: center;
    z-index: 100;
  }
  .help-overlay.is-open { display: flex; }
  .help-card {
    background: var(--bg-elev);
    border: 1px solid var(--rule);
    border-radius: 12px;
    padding: 28px 32px;
    max-width: 460px;
    width: calc(100% - 48px);
  }
  .help-card h3 {
    font-family: var(--mono); font-weight: 700;
    color: var(--fg); margin: 0 0 16px;
    font-size: 1rem;
  }
  .help-card dl {
    font-family: var(--mono); font-size: 0.84rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 8px 18px;
    margin: 0;
  }
  .help-card dt {
    color: var(--accent);
    text-align: right;
  }
  .help-card dd {
    color: var(--fg-soft);
    margin: 0;
  }
  .help-close {
    margin-top: 22px;
    appearance: none; background: transparent;
    border: 1px solid var(--rule);
    color: var(--fg-soft);
    padding: 6px 14px; border-radius: 4px;
    cursor: pointer; font: inherit;
    font-family: var(--mono); font-size: 0.76rem;
  }
  .help-close:hover { border-color: var(--accent); color: var(--accent); }

  /* Footer status bar */
  .statusbar {
    position: fixed; bottom: 0; left: 0; right: 0;
    background: var(--bg-elev);
    border-top: 1px solid var(--rule);
    padding: 6px 24px;
    font-family: var(--mono); font-size: 0.72rem;
    color: var(--muted);
    display: flex; gap: 24px;
    justify-content: space-between;
    z-index: 30;
  }
  .statusbar .left { display: flex; gap: 18px; }
  .statusbar .right { display: flex; gap: 14px; }
  .statusbar .live { color: var(--accent); }
  .statusbar .kbd {
    color: var(--fg-soft);
    background: var(--bg);
    border: 1px solid var(--rule);
    padding: 0 5px; border-radius: 3px;
  }
  main { padding-bottom: 80px; }

  @media (max-width: 820px) {
    .stats { grid-template-columns: repeat(3, 1fr); }
    .row { grid-template-columns: 90px 1fr; }
    .r-actions { display: none; }
    .topbar-inner { grid-template-columns: auto 1fr; }
    .topbar-status { display: none; }
    .statusbar { font-size: 0.66rem; padding: 6px 14px; }
  }
  @media (max-width: 560px) {
    .stats { grid-template-columns: repeat(2, 1fr); }
    .hero { padding: 32px 16px 16px; }
    .topbar-inner { padding: 12px 16px; }
    .filter-bar { padding: 12px 16px 10px; }
    main { padding: 16px 16px 80px; }
    .r-foot { flex-direction: column; align-items: flex-start; gap: 6px; }
    .r-profiles { margin-left: 0; }
  }
</style>
</head>
<body>

<!-- Top bar -->
<div class="topbar">
  <div class="topbar-inner">
    <div class="brand">
      <span class="prompt">$</span><span>cd</span><span class="path">{{BRAND_PATH}}</span>
    </div>
    <div class="search-wrap">
      <span class="sigil">▸</span>
      <input id="search" type="search" placeholder='{{SEARCH_PLACEHOLDER}}' aria-label="検索">
      <span class="search-hint">/ キーで検索フォーカス</span>
    </div>
    <div class="topbar-status">
      <span><span class="live" id="visible-count">{{TOTAL_COUNT}}</span> / {{TOTAL_COUNT}} 件表示</span>
      <span class="kbd" id="help-btn">?</span>
    </div>
  </div>
</div>

<!-- Hero -->
<header class="hero">
{{HERO}}
</header>

<!-- Stats -->
<section class="stats" aria-label="統計">
{{STATS}}
</section>

<!-- Filter bar -->
<nav class="filter-bar" aria-label="絞り込み">
{{FILTER_BAR}}
</nav>

<main>
{{MAIN}}
</main>

<!-- Help overlay -->
<div class="help-overlay" id="help-overlay">
  <div class="help-card">
    <h3>キーボードショートカット</h3>
    <dl>
      <dt>/</dt><dd>検索にフォーカス</dd>
      <dt>Esc</dt><dd>フィルタクリア／ヘルプを閉じる</dd>
      <dt>1-9, 0</dt><dd>カテゴリ 01〜10 へ移動</dd>
      <dt>g h</dt><dd>先頭へスクロール</dd>
      <dt>?</dt><dd>このヘルプの表示切替</dd>
    </dl>
    <button class="help-close" type="button">閉じる</button>
  </div>
</div>

<!-- Status bar -->
<div class="statusbar">
  <div class="left">
    <span><span class="live" id="sb-visible">{{TOTAL_COUNT}}</span>/<span id="sb-total">{{TOTAL_COUNT}}</span> 件</span>
    <span id="sb-filters">フィルタなし</span>
  </div>
  <div class="right">
    <span><span class="kbd">/</span> 検索</span>
    <span><span class="kbd">Esc</span> クリア</span>
    <span><span class="kbd">?</span> ヘルプ</span>
    <span>{{VERSION_LABEL}}</span>
  </div>
</div>

<script>
(function () {
  var rows = document.querySelectorAll('.row');
  var cats = document.querySelectorAll('.category');
  var srcBtns = document.querySelectorAll('.src-btn');
  var catBtns = document.querySelectorAll('.cat-btn');
  var tagChips = document.querySelectorAll('.tag-chip');
  var search = document.getElementById('search');
  var clearBtn = document.getElementById('clear-btn');
  var helpBtn = document.getElementById('help-btn');
  var helpOverlay = document.getElementById('help-overlay');
  var helpClose = document.querySelector('.help-close');
  var visibleCount = document.getElementById('visible-count');
  var sbVisible = document.getElementById('sb-visible');
  var sbFilters = document.getElementById('sb-filters');
  var activeFilters = document.getElementById('active-filters');
  var body = document.body;

  var state = {
    cat: 'all',
    src: 'all',
    q: '',
    tags: new Set(),
  };

  function pushHash() {
    var parts = [];
    if (state.cat !== 'all') parts.push('cat=' + state.cat);
    if (state.src !== 'all') parts.push('src=' + state.src);
    if (state.q) parts.push('q=' + encodeURIComponent(state.q));
    if (state.tags.size) parts.push('tags=' + Array.from(state.tags).join(','));
    var h = parts.join('&');
    if (h) history.replaceState(null, '', '#' + h);
    else history.replaceState(null, '', location.pathname + location.search);
  }

  function readHash() {
    var h = location.hash.replace(/^#/, '');
    if (!h) return;
    h.split('&').forEach(function (kv) {
      var ix = kv.indexOf('=');
      if (ix < 0) return;
      var k = kv.slice(0, ix), v = decodeURIComponent(kv.slice(ix + 1));
      if (k === 'cat') state.cat = v;
      else if (k === 'src') state.src = v;
      else if (k === 'q') state.q = v;
      else if (k === 'tags') state.tags = new Set(v.split(',').filter(Boolean));
    });
    if (state.q) search.value = state.q;
  }

  function apply() {
    var n = 0;
    rows.forEach(function (r) {
      var srcOk = state.src === 'all' || r.getAttribute('data-source') === state.src;
      var rowName = r.getAttribute('data-name') || '';
      var rowTags = (r.getAttribute('data-tags') || '').split(' ').filter(Boolean);
      var qOk = !state.q || rowName.indexOf(state.q) >= 0 || (r.innerText || '').toLowerCase().indexOf(state.q) >= 0;
      var tagsOk = true;
      if (state.tags.size) {
        var rt = new Set(rowTags);
        state.tags.forEach(function (t) { if (!rt.has(t)) tagsOk = false; });
      }
      var visible = srcOk && qOk && tagsOk;
      r.classList.toggle('is-hidden', !visible);
      if (visible) n++;
    });
    cats.forEach(function (sec) {
      var slug = sec.getAttribute('data-cat');
      var catOk = state.cat === 'all' || slug === state.cat;
      var anyVisible = false;
      sec.querySelectorAll('.row').forEach(function (r) {
        if (!r.classList.contains('is-hidden')) anyVisible = true;
      });
      sec.classList.toggle('is-hidden', !catOk || !anyVisible);
      // update per-cat count
      var perCat = 0;
      sec.querySelectorAll('.row').forEach(function (r) {
        if (!r.classList.contains('is-hidden')) perCat++;
      });
      var btn = document.querySelector('.cat-btn[data-cat="' + slug + '"]');
      if (btn) {
        var ctEl = btn.querySelector('.ct');
        if (ctEl) ctEl.textContent = perCat;
      }
    });
    srcBtns.forEach(function (b) { b.classList.toggle('active', b.getAttribute('data-src') === state.src); });
    catBtns.forEach(function (b) { b.classList.toggle('active', b.getAttribute('data-cat') === state.cat); });
    tagChips.forEach(function (c) { c.classList.toggle('active', state.tags.has(c.getAttribute('data-tag'))); });
    visibleCount.textContent = n;
    sbVisible.textContent = n;
    body.classList.toggle('is-no-match', n === 0);
    renderActiveFilters();
    pushHash();
  }

  function renderActiveFilters() {
    var chips = [];
    if (state.cat !== 'all') chips.push({ k: 'cat', v: state.cat, label: 'カテゴリ:' + state.cat });
    if (state.src !== 'all') chips.push({ k: 'src', v: state.src, label: 'ソース:' + state.src });
    if (state.q) chips.push({ k: 'q', v: state.q, label: '検索:' + state.q });
    state.tags.forEach(function (t) { chips.push({ k: 'tag', v: t, label: '#' + t }); });
    activeFilters.innerHTML = chips.map(function (c) {
      return '<span class="active-filter" data-k="' + c.k + '" data-v="' + c.v + '">' + c.label + ' <span class="x">⨯</span></span>';
    }).join('');
    activeFilters.querySelectorAll('.active-filter .x').forEach(function (x) {
      x.addEventListener('click', function () {
        var p = x.parentElement;
        var k = p.getAttribute('data-k'), v = p.getAttribute('data-v');
        if (k === 'cat') state.cat = 'all';
        else if (k === 'src') state.src = 'all';
        else if (k === 'q') { state.q = ''; search.value = ''; }
        else if (k === 'tag') state.tags.delete(v);
        apply();
      });
    });
    sbFilters.textContent = chips.length ? chips.map(function (c) { return c.label; }).join(' ') : 'フィルタなし';
  }

  srcBtns.forEach(function (b) {
    b.addEventListener('click', function () { state.src = b.getAttribute('data-src'); apply(); });
  });
  catBtns.forEach(function (b) {
    b.addEventListener('click', function () {
      state.cat = b.getAttribute('data-cat');
      apply();
      if (state.cat !== 'all') {
        var sec = document.getElementById('cat-' + state.cat);
        if (sec) window.scrollTo({ top: window.scrollY + sec.getBoundingClientRect().top - 130, behavior: 'smooth' });
      }
    });
  });
  tagChips.forEach(function (c) {
    c.addEventListener('click', function () {
      var t = c.getAttribute('data-tag');
      if (state.tags.has(t)) state.tags.delete(t); else state.tags.add(t);
      apply();
    });
  });

  var t;
  search.addEventListener('input', function () {
    clearTimeout(t);
    t = setTimeout(function () {
      state.q = search.value.trim().toLowerCase();
      apply();
    }, 80);
  });

  clearBtn.addEventListener('click', function () {
    state.cat = 'all'; state.src = 'all'; state.q = ''; state.tags.clear();
    search.value = '';
    apply();
  });

  // Copy buttons
  document.querySelectorAll('.copy-btn').forEach(function (b) {
    b.addEventListener('click', function (e) {
      e.stopPropagation();
      var txt = b.getAttribute('data-copy');
      var done = function () {
        b.classList.add('copied');
        var orig = b.textContent;
        b.textContent = '完了';
        setTimeout(function () { b.classList.remove('copied'); b.textContent = orig; }, 900);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(txt).then(done, done);
      } else {
        done();
      }
    });
  });

  // Help overlay
  function toggleHelp(open) {
    helpOverlay.classList.toggle('is-open', open);
  }
  helpBtn.addEventListener('click', function () { toggleHelp(true); });
  helpClose.addEventListener('click', function () { toggleHelp(false); });
  helpOverlay.addEventListener('click', function (e) {
    if (e.target === helpOverlay) toggleHelp(false);
  });

  // Keyboard shortcuts
  document.addEventListener('keydown', function (e) {
    var active = document.activeElement;
    var inField = active && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA');
    if (e.key === '/' && !inField) {
      e.preventDefault();
      search.focus(); search.select();
    } else if (e.key === 'Escape') {
      if (helpOverlay.classList.contains('is-open')) {
        toggleHelp(false);
      } else if (inField) {
        search.blur();
      } else {
        clearBtn.click();
      }
    } else if (e.key === '?' && !inField) {
      e.preventDefault();
      toggleHelp(!helpOverlay.classList.contains('is-open'));
    } else if (!inField && /^[0-9]$/.test(e.key)) {
      var idx = e.key === '0' ? 10 : parseInt(e.key, 10);
      var btns = document.querySelectorAll('.cat-btn[data-cat]:not([data-cat="all"])');
      var target = btns[idx - 1];
      if (target) target.click();
    } else if (e.key === 'g' && !inField) {
      // wait for next key
      var handler = function (e2) {
        if (e2.key === 'h') {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
        document.removeEventListener('keydown', handler, true);
      };
      document.addEventListener('keydown', handler, true);
      setTimeout(function () { document.removeEventListener('keydown', handler, true); }, 700);
    }
  });

  // initial
  readHash();
  apply();
})();
</script>
</body>
</html>

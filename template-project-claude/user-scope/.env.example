# <config-dir>/.env の雛形。setup-user-scope.sh は .env を配置しない（秘匿情報のため）。
# 新しいマシンでは本ファイルをコピーして実値を埋める:
#
#   cp user-scope/.env.example ~/.claude/.env   # macOS / Linux
#   cp user-scope/.env.example "$USERPROFILE/.claude/.env"   # Windows (Git Bash)
#
# 実値を本ファイルに書き戻さないこと。user-scope/.gitignore は .env のみを除外しており、
# .env.example は追跡対象である。

# Notion インテグレーションの内部トークン。notion_sync.py と Notion MCP が共有する。
# https://www.notion.so/profile/integrations で発行する。
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxx

# 無人実行（launchd の日次 / 週次記録、macOS のみ）用。Keychain の OAuth より優先される。
# `claude setup-token` で発行する 1 年有効・サブスク枠トークン。API 従量課金にはならない。
# 手動でしか /notion-digest を使わないなら不要。
CLAUDE_CODE_OAUTH_TOKEN=
